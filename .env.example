# Required for AI generation (Milestone 4+).
# Get a key at https://console.anthropic.com — this is a separate account
# from claude.ai and is billed per request (there's a free trial credit).
ANTHROPIC_API_KEY=

# Optional — defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=

# Required for accounts + saving decks (Milestone 7+).
# Find these in your Supabase project under Project Settings > API.
# Both are safe to expose to the browser (NEXT_PUBLIC_) — the real
# protection is Row Level Security on the presentations table, not secrecy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for export credits (Milestone 9+).
# SUPABASE_SERVICE_ROLE_KEY: Project Settings > API > "service_role" secret
# key. NEVER expose this to the browser (no NEXT_PUBLIC_ prefix) — it
# bypasses Row Level Security entirely. Used only server-side, to credit an
# account after a payment is verified directly against Stripe.
SUPABASE_SERVICE_ROLE_KEY=

# STRIPE_SECRET_KEY: Stripe Dashboard > Developers > API keys > Secret key.
# Start with the TEST mode key (starts with sk_test_) so purchases can be
# tried with Stripe's test card (4242 4242 4242 4242, any future date/CVC)
# before ever switching to a live key. Server-side only.
STRIPE_SECRET_KEY=
